<apex:page lightningStylesheets="true">
<apex:slds/>

<div class="slds-scope">
    <div class ="slds-p-around_small">
        <label>Enter the message to be published here</label>
        <input type="text" class="slds-input" id="messageid" placeholder="Enter message here" />
        <div class="slds-m-top_small slds-p-bottom_small">
            <button class="slds-button slds-button_brand" id="publishButton"
             onclick="publish()">Publish</button>

            <button class="slds-button slds-button_neutral" id="Susbcribe"
             onclick="Susbcribe()">Susbcribe</button>

            <button class="slds-button slds-button_destructive" id="unsubscribeButton"
             onclick="UnSusbcribe()">UnSusbcribe</button>

        </div>
        <div class="slds-m-top_small">
            <label>Message from LWC</label>
            <div id="messageFromLWC"></div>   

         </div>
     </div>
</div>

<script>
let SAMPLEMC="{!$MessageChannel.SampleMessagingChannel__c}";
let subscriptionid;
function publish() {
    const message = document.getElementById("messageid").value;
    const msg={
        LMSComponentAData:{
            value:message
        }
    }
    sforce.one.publish(SAMPLEMC, msg);
    
}
function Susbcribe() {
    if(!subscriptionid){
    subscriptionid= sforce.one.subscribe(SAMPLEMC, msghandler,
        {
            scope: "APPLICATION"
        });
    }
}
function UnSusbcribe() {
  if(subscriptionid) {
    sforce.one.unsubscribe(subscriptionid);
    subscriptionid = null;
  }
}
function msghandler(messagerecive){
    let recmsg=document.getElementById("messageFromLWC");
    recmsg.innerHTML=messagerecive && messagerecive.LMSComponentAData ?messagerecive.LMSComponentAData.value:"No data recived";
}

</script>
</apex:page>